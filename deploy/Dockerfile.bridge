# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY packages/wechat-bridge/package.json ./packages/wechat-bridge/package.json
COPY packages/wechat-bridge/src ./packages/wechat-bridge/src
# 非 root 运行（红线：禁止 root 常驻）；node 镜像自带 node 用户
USER node
EXPOSE 8080
# 健康检查不依赖 curl/wget：用 Node 自己的 fetch 打 /healthz
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "packages/wechat-bridge/src/cli.js"]
CMD ["--adapter", "http"]
