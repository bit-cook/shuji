# ===== 命令路由 · Telegram 入口（chmod 600，禁止入库入镜像）=====
# 与 wechat-bridge.env（HTTP / 微信经 OpenClaw）分开：两个适配器同时跑，
# 各自的白名单、审计文件、令牌互不干扰。
MC_BASE=http://127.0.0.1:3000
MC_API_KEY=替换为控制面同一个值

ADAPTER=telegram
# 机器人令牌（@xiemate_bot）。启动时先 getMe 校验，令牌错就立刻失败而不是静默重试。
TELEGRAM_BOT_TOKEN=替换为机器人令牌
TELEGRAM_VALIDATE_TOKEN=1
# 首次发现发送者时要处理积压消息，设 0；稳定后改 1（丢弃宕机期间积压）
TELEGRAM_DRAIN_BACKLOG=1
TELEGRAM_POLL_TIMEOUT=30

# 白名单（红线：只留本人）。数字用户 ID，找 @userinfobot 问一句即可。
TELEGRAM_ALLOW_FROM=123456789

AUDIT_LOG=/var/log/wechat-bridge/telegram-audit.jsonl
AUDIT_MAX_BYTES=10485760
AUDIT_KEEP=3

CONFIRM_TTL_MS=60000
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20

HOST=127.0.0.1
PORT=8081
