# ===== Hermes 心跳 Sidecar 环境变量（chmod 600）=====
MC_BASE=http://mc-console:3000
MC_API_KEY=替换为管理面APIKey

# 本节点在控制面的 agentId（全局唯一）
AGENT_ID=hermes-node-b

# Hermes 状态接口；不可用时退化查 systemd 单元
HERMES_RPC=http://127.0.0.1:8765/status
SYSTEMD_UNIT=agent-gateway

# 心跳周期（秒）与重试
INTERVAL=300
RETRY_MAX=3
RETRY_BACKOFF=2
REQUEST_TIMEOUT=10
