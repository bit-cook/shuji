# ===== 枢机 · 控制面 mission-control 环境变量（chmod 600，禁止入库入镜像）=====
# 监听：默认只绑回环。跨主机请填 Tailscale 网卡地址（100.x.x.x），
#       确需通配绑定时才设 ALLOW_PUBLIC_BIND=1（红线：不暴露公网）。
MC_HOST=127.0.0.1
MC_PORT=3000
# ALLOW_PUBLIC_BIND=1

# API Key（必填）：命令路由与心跳 Sidecar 都用这个值做 Bearer 鉴权
MC_API_KEY=替换为随机长字符串

# SQLite 数据库位置（目录会自动创建，权限 750）
MC_DB=/var/lib/mission-control/mission-control.db

# 审计日志（JSONL，一行一条；默认开启，写 none 才关闭）
MC_AUDIT_LOG=/var/log/mission-control/audit.jsonl
MC_AUDIT_MAX_BYTES=10485760
MC_AUDIT_KEEP=3

# 心跳超过该秒数无更新 → /list 一律报 offline（防止面板把死掉的 Agent 显示成在线）
MC_STALE_SEC=900
# 每 Agent 保留的任务条数上限（0 = 不清理）
MC_TASKS_PER_AGENT=500
# 任务标题上限（超长截断并在响应里回带 titleTruncated）
MC_MAX_TASK_TITLE=4000

# 每客户端 IP 限流（0 = 关闭）：防重试风暴把库打满
MC_RATE_LIMIT_PER_MIN=600
MC_RATE_LIMIT_BURST=200
# 请求体上限（字节）
MC_MAX_BODY_BYTES=1048576

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
