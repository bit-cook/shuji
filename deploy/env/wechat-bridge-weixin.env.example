# ===== 命令路由 · 微信入口（chmod 600，禁止入库入镜像）=====
# 枢机自己实现的 iLink 连接：不需要安装 OpenClaw，也不经过任何第三方 Agent 宿主。
# 与其他入口分开：各自的白名单、审计文件、令牌互不干扰。
MC_BASE=http://127.0.0.1:3000
MC_API_KEY=替换为控制面同一个值

ADAPTER=weixin

# 登录态持久化（红线：内含机器人令牌，权限固定 0600）。
# 首次使用前，在有终端的机器上以 wechat-bridge 账号跑一次扫码登录：
#   sudo -u wechat-bridge \
#     WECHAT_STATE_FILE=/var/lib/wechat-bridge-weixin/state.json \
#     WECHAT_ALLOW_FROM=你的微信用户ID \
#     node /opt/wechat-bridge/src/cli.js --adapter weixin --login
# 登录成功后把上面打印的「扫码账号 ID」填进 WECHAT_ALLOW_FROM。
WECHAT_STATE_FILE=/var/lib/wechat-bridge-weixin/state.json
# 已登录得到的机器人令牌（可选）。填了就优先用它，不读状态文件里的令牌；
# 留空则从 WECHAT_STATE_FILE 读——两条路都没有时启动即失败。
# WECHAT_BOT_TOKEN=

# 接入点与机器人类型（一般不用改）。登录时服务端可能下发新的接入点，
# 之后以状态文件里记录的为准，这个值只在首次登录时生效。
WECHAT_API_BASE=https://ilinkai.weixin.qq.com
WECHAT_BOT_TYPE=3
# 扫码登录总时长（毫秒），默认 480000（8 分钟）
WECHAT_LOGIN_TIMEOUT_MS=480000

# 白名单（红线：只留本人）。微信用户 ID，扫码登录时会原样打印出来。
WECHAT_ALLOW_FROM=你的微信用户ID

AUDIT_LOG=/var/log/wechat-bridge/weixin-audit.jsonl
AUDIT_MAX_BYTES=10485760
AUDIT_KEEP=3

CONFIRM_TTL_MS=60000
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
