# ===== 命令路由 wechat-bridge 环境变量（chmod 600，禁止入库入镜像）=====
# 管理面
MC_BASE=http://mc-console:3000
MC_API_KEY=替换为管理面APIKey

# 命令入口白名单（红线：只留本人，至少填一项）
#   微信（经 OpenClaw 插件转发）：你的微信用户 ID
WECHAT_ALLOW_FROM=你的微信用户ID
#   Telegram：你的数字用户 ID（找 @userinfobot 问一句即可）
TELEGRAM_ALLOW_FROM=123456789

# 审计日志（JSONL，一行一条）
AUDIT_LOG=/var/log/wechat-bridge/audit.jsonl

# 危险命令确认令牌有效期（毫秒）
CONFIRM_TTL_MS=60000

# HTTP 适配路径（OpenClaw 插件走 /openclaw，人工排查走 /message）
HTTP_PATHS=/message,/openclaw
HOST=127.0.0.1
PORT=8080

# ===== Telegram 适配器（ADAPTER=telegram 时必填）=====
# BotFather 令牌；长轮询，无需公网地址
TELEGRAM_BOT_TOKEN=替换为机器人令牌
# 启动时丢弃宕机期间积压的消息（1=丢弃，0=处理）
TELEGRAM_DRAIN_BACKLOG=1
TELEGRAM_POLL_TIMEOUT=30

# ===== 企业微信自建应用（可选备选入口，ADAPTER=wecom 时填写）=====
# WECOM_CORP_ID=企业ID
# WECOM_AGENT_ID=应用AgentId
# WECOM_SECRET=应用Secret
# WECOM_TOKEN=回调Token
# WECOM_ENCODING_AES_KEY=回调EncodingAESKey（43字符）
# WECOM_CALLBACK_PATH=/callback
