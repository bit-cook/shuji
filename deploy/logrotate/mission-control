# 枢机控制面审计日志轮转（mission-control 自带 10MB 轮转，这里再兜一层防写满磁盘）
# 安装：sudo cp deploy/logrotate/mission-control /etc/logrotate.d/mission-control
# 说明：控制面每次审计都是按路径 appendFileSync，logrotate 改名后下一条自动写新文件，
#      因此不需要给进程发信号（控制面不处理 HUP，发信号反而会杀掉它）。
/var/log/mission-control/audit.jsonl {
    daily
    rotate 14
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    create 0600 mission-control mission-control
}
